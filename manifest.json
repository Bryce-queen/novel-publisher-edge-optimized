{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.12.0",
  "default_locale": "zh_CN",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "notifications",
    "sidePanel",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://docs.qq.com/*",
    "https://fanqienovel.com/*",
    "https://*.fanqienovel.com/*",
    "https://open.bigmodel.cn/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.qq.com/doc/*"],
      "js": ["content_scripts/tencent_doc.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://fanqienovel.com/main/writer/*",
        "https://*.fanqienovel.com/main/writer/*"
      ],
      "exclude_matches": [
        "https://fanqienovel.com/main/writer/chapter-manage*",
        "https://*.fanqienovel.com/main/writer/chapter-manage*"
      ],
      "js": ["shared/fanqie-adapter.js", "content_scripts/fanqie_editor.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://fanqienovel.com/main/writer/chapter-manage*",
        "https://*.fanqienovel.com/main/writer/chapter-manage*"
      ],
      "js": ["content_scripts/fanqie_manager.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
